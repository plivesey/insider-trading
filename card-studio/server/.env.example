# Copy this file to .env and fill in values. .env is gitignored and is NOT
# synced via Drive — each machine needs its own.

# Required to call OpenAI's image generation API.
OPENAI_API_KEY=

# Folder where all Card Studio data (templates, cards, generated images) is
# stored. Point this at your local Google Drive Desktop sync folder (or
# Dropbox, etc.) to share data with a teammate — Card Studio never talks to
# Drive directly, it just reads/writes plain files here and lets Drive sync
# the folder like any other.
DATA_DIR=./data

# Port the API server listens on.
PORT=4100

# Set to "true" to skip the real OpenAI call and always return a fixture
# image instead (server/assets/mock-generation.png) — no API key needed, no
# cost, deterministic. Always set this for browser QA / UI testing; leave
# unset for real generation.
MOCK_OPENAI_IMAGES=false
